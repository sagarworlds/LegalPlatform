{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**remainder}"
        }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/users/{**remainder}"
        }
      },
      "organization-route": {
        "ClusterId": "organization-cluster",
        "Match": {
          "Path": "/api/v1/organizations/{**remainder}"
        }
      },
      "document-route": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/api/v1/documents/{**remainder}"
        }
      },
      "case-route": {
        "ClusterId": "case-cluster",
        "Match": {
          "Path": "/api/v1/cases/{**remainder}"
        }
      },
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/v1/workflows/{**remainder}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**remainder}"
        }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/v1/search/{**remainder}"
        }
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**remainder}"
        }
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/audit/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identityservice"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userservice"
          }
        }
      },
      "organization-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://organizationservice"
          }
        }
      },
      "document-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://documentservice"
          }
        }
      },
      "case-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://caseservice"
          }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://workflowservice"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notificationservice"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://searchservice"
          }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reportingservice"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auditservice"
          }
        }
      }
    }
  }
}
