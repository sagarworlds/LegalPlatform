    <Import Project="$(NuGetPackageRoot)aspire.hosting.apphost\9.0.0\build\Aspire.Hosting.AppHost.props" Condition="Exists('$(NuGetPackageRoot)aspire.hosting.apphost\9.0.0\build\Aspire.Hosting.AppHost.props')" />
